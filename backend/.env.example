# Сервис извлечения характеристик товаров E-Commerce AI
# Скопируйте этот файл в .env и укажите ваши параметры конфигурации

# Режим экстрактора (cascade | regex | gliner)
EXTRACTOR=cascade
CONFIDENCE_THRESHOLD=0.87
GLINER_THRESHOLD=0.30

# Флаги активности уровней каскада (true | false)
USE_GLINER=true
USE_CATALOG_ENRICHER=true
USE_LLM=true

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:8000

# Безопасность API (опционально: если задан, доступ к эндпойнтам требует заголовок X-API-Key)
API_KEY=

# LLM Fallback (GigaSchool API / OpenAI-совместимый эндпоинт)
# Укажите ваш персональный API ключ (никогда не коммитьте боевой .env файл в git!)
LLM_API_BASE=https://hub.gigaschool.ru/api/v1/llm/v1
LLM_API_KEY=your_api_key_here
LLM_MODEL=GigaChat/GigaChat-3-Pro
ENFORCE_LLM_GROUNDING=true
LLM_TIMEOUT_SECONDS=3.5
