# Сервис извлечения характеристик товаров E-Commerce AI (Корневой шаблон)
EXTRACTOR=cascade
CONFIDENCE_THRESHOLD=0.87
GLINER_THRESHOLD=0.30
USE_GLINER=true
USE_CATALOG_ENRICHER=true
USE_LLM=true

# API авторизация (опционально)
API_KEY=

# LLM Fallback
LLM_API_BASE=https://hub.gigaschool.ru/api/v1/llm/v1
LLM_API_KEY=your_api_key_here
LLM_MODEL=GigaChat/GigaChat-3-Pro
ENFORCE_LLM_GROUNDING=true
LLM_TIMEOUT_SECONDS=3.5
